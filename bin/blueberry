#!/usr/bin/env bash
# blueberry — single-binary product (CLI + the forked pi runtime in-process).
# Dev layout: prefer the compiled binary (deno task compile → dist/blueberry),
# else fall back to deno run. Alias it: alias bb='~/Development/blueberry/bin/blueberry'
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [ -x "$HERE/dist/blueberry" ]; then
  exec "$HERE/dist/blueberry" "$@"
fi
exec deno run -A --no-check "$HERE/src/cli/entry.ts" "$@"
