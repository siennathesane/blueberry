{
  "name": "blueberry",
  "version": "0.1.0",
  "private": true,
  "description": "A personal pi distribution. Blueberry pi, served with orange juice.",
  "keywords": ["pi-package"],
  "type": "module",
  "scripts": {
    "setup": "bash bin/setup.sh",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-exclude='src/cli/entry.ts' --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=90"
  },
  "bin": {
    "blueberry": "./bin/blueberry"
  },
  "engines": {
    "node": ">=23.6"
  },
  "pi": {
    "extensions": [
      "./extensions/core/index.ts",
      "./extensions/plan/index.ts",
      "./extensions/todo/index.ts",
      "./extensions/search/index.ts"
    ],
    "skills": ["./skills"],
    "prompts": ["./prompts"],
    "themes": ["./themes"]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@types/node": "*",
    "typebox": "*",
    "typescript": "^5"
  }
}
