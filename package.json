{
	"name": "blueberry",
	"version": "0.4.1",
	"private": true,
	"description": "A personal pi distribution. Blueberry pi, served with orange juice.",
	"keywords": [
		"pi-package"
	],
	"type": "module",
	"scripts": {
		"setup": "bash bin/setup.sh",
		"typecheck": "deno task check",
		"test": "deno task test",
		"coverage": "deno task coverage"
	},
	"bin": {
		"blueberry": "./bin/blueberry"
	},
	"pi": {
		"extensions": [
			"./extensions/core/index.ts",
			"./extensions/library/index.ts",
			"./extensions/lsp/index.ts",
			"./extensions/plan/index.ts",
			"./src/core/tools/search.ts",
			"./src/core/tools/mint-id.ts",
			"./extensions/todo/index.ts"
		],
		"skills": [
			"./skills"
		],
		"prompts": [
			"./prompts"
		],
		"themes": [
			"./themes"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@types/node": "*",
		"typebox": "*",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"typescript-language-server": "^6.0.0"
	}
}
