{
  "name": "blueberry",
  "version": "0.1.0",
  "private": true,
  "description": "A personal pi distribution. Blueberry pi, served with orange juice.",
  "keywords": ["pi-package"],
  "type": "module",
  "scripts": {
    "setup": "bash bin/setup.sh",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./extensions/core/index.ts",
      "./extensions/plan/index.ts",
      "./extensions/todo/index.ts",
      "./extensions/search/index.ts"
    ],
    "skills": ["./skills"],
    "prompts": ["./prompts"],
    "themes": ["./themes"]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@types/node": "*",
    "typebox": "*",
    "typescript": "^5"
  }
}
