{
	"tasks": {
		"check": "deno check src/ test/ extensions/",
		"test": "deno test -A test/",
		"test:unit": "deno test -A --skip e2e test/",
		"coverage": "deno test -A --coverage --clean test/ && deno coverage --line --branch --function",
		"run": "deno run -A src/cli/entry.ts",
		"compile": "deno compile -A --output bin/blueberry-bin src/cli/entry.ts && deno compile -A --output bin/blueberry-pi pi/packages/coding-agent/dist/bundle/cli.js"
	},
	"compilerOptions": {
		"strict": true,
		"noUncheckedIndexedAccess": true
	},
	"nodeModulesDir": "auto"
}
