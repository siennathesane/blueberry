		"hosted-git-info": "npm:hosted-git-info@9.0.3",
		"ignore": "npm:ignore@7.0.5",
		"jiti": "npm:jiti@2.7.0",
		"minimatch": "npm:minimatch@10.2.5",
		"proper-lockfile": "npm:proper-lockfile@4.1.2",
		"semver": "npm:semver@7.8.0",
		"typebox": "npm:typebox@1.3.7",
