{
	"tasks": {
		"check": "deno check src/ test/ extensions/",
		"test": "deno test -A test/",
		"test:unit": "deno test -A --skip e2e test/",
		"coverage": "deno test -A --coverage --clean test/ && deno coverage --line --branch --function",
		"run": "deno run -A src/cli/entry.ts",
		"compile": "deno compile -A --include pi/packages/coding-agent/src/modes/interactive/theme --include pi/packages/coding-agent/src/modes/interactive/assets --include pi/packages/coding-agent/src/core/export-html --output dist/blueberry src/cli/entry.ts",
		"start": "deno run -A --no-check src/cli/entry.ts"
	},
	"compilerOptions": {
		"strict": true,
		"noUncheckedIndexedAccess": false,
		"noImplicitOverride": false
	},
	"nodeModulesDir": "auto",
	"imports": {
		"@earendil-works/pi-agent-core": "./pi/packages/agent/src/index.ts",
		"@earendil-works/pi-ai": "./pi/packages/ai/src/index.ts",
