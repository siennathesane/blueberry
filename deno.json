		"@aws-sdk/client-bedrock-runtime": "npm:@aws-sdk/client-bedrock-runtime@3.1048.0",
		"@google/genai": "npm:@google/genai@1.52.0",
		"@smithy/node-http-handler": "npm:@smithy/node-http-handler@4.7.3",
		"http-proxy-agent": "npm:http-proxy-agent@7.0.2",
